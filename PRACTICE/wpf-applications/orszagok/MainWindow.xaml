<Window x:Class="orszagok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:orszagok"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <!-- Kulcs nélküli stílus: minden CheckBox-ra automatikusan érvényes -->
        <Style TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Kerek jelölő: a CornerRadius a méret fele, így a négyzetből kör lesz -->
                            <Border Grid.Column="0"
                                    Width="18" Height="18"
                                    CornerRadius="9"
                                    BorderBrush="Black" BorderThickness="1"
                                    Background="White"
                                    VerticalAlignment="Center">
                                <!-- Pipa helyett kitöltött kör; kezdetben rejtve, a trigger kapcsolja be -->
                                <Ellipse x:Name="Mark"
                                         Width="10" Height="10"
                                         Fill="Black"
                                         Visibility="Collapsed" />
                            </Border>

                            <!-- A Content (felirat) megjelenítése; nélküle eltűnne a szöveg -->
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_Fájl">
                    <MenuItem Header="_Open" Click="Open_Click"/>
                </MenuItem>
                <MenuItem Header="_Európaiak" Click="European_Click" />
            </Menu>
        </DockPanel>

        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="CountryPopulationTextBlock" 
                       Text="ORSZÁGOK NÉPESSÉGE" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <ListBox Grid.RowSpan="8" Grid.Row="1" Grid.Column="0" Width="270" x:Name="CountriesListBox" />

            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="1" x:Name="WhatToCountTextBlock" Text="Mit számoljak?" Margin="10,0,0,0"/>

            <StackPanel Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,0">
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4"
                        Padding="8">
                    <StackPanel >
                        <CheckBox x:Name="MoreCheck" Content="10 milliónál több" Margin="0,4" IsChecked="True" />
                        <CheckBox x:Name="LessCheck" Content="Legfeljebb 10 millió" Margin="0,4" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Grid.Row="4" Grid.Column="1" x:Name="count" Content="megszámol" Width="120" Height="20" HorizontalAlignment="Left" Margin="10,0,0,0" Click="Count_Click" />
            <TextBox x:Name="countTextBox" Grid.Row="4" Grid.Column="2" Width="190" Height="20" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Grid.Column="1" x:Name="Biggest" Text="legnagyobb/legkisebb népesség:" Margin="10,0,0,0"/>

            <ComboBox Grid.Row="6" Grid.Column="1" Width="160" Height="20" HorizontalAlignment="Left" Margin="10,0,0,0">
                <ComboBoxItem x:Name="ComboBoxBiggest" IsSelected="True">Legnagyobb</ComboBoxItem>
                <ComboBoxItem x:Name="ComboBoxSmallest">Legkisebb</ComboBoxItem>
            </ComboBox>

            <Button Grid.Row="6" Grid.Column="2" x:Name="print" Content="kiiratás" Width="120" Height="20" HorizontalAlignment="Center" Click="Print_Click" />

            <Button Grid.Row="8" Grid.Column="1" x:Name="average" Content="átlag népesség" Width="160" Height="20" HorizontalAlignment="Left" Margin="10,0,0,0" Click="Average_Click" />
            <Button Grid.Row="8" Grid.Column="2" 
                    x:Name="close" 
                    Content="kilépés" 
                    Width="120" 
                    Height="20" 
                    HorizontalAlignment="Center" 
                    Margin="10,0,0,0"
                    Click="Close_Click"/>

        </Grid>
    </Grid>
</Window>
