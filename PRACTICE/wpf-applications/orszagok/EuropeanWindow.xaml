<Window x:Class="orszagok.EuropeanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:orszagok"
        mc:Ignorable="d"
        Title="EuropeanWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Title" Text="EURÓPAI ORSZÁGOK" FontWeight="Bold" HorizontalAlignment="Center" />
            <ListBox Grid.Row="1" x:Name="EuropeanListBox" Margin="20" >
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="PrintToResult" Click="PrintResults_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Grid>
    </Grid>
</Window>
