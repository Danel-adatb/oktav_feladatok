<Window x:Class="cukraszda.BusinessCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cukraszda"
        mc:Ignorable="d"
        Title="BusinessCardWindow" Height="450" Width="800">
    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Text="Név" />
        <TextBlock Grid.Column="0" Grid.Row="1" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Text="Csoport" />
        <TextBlock Grid.Column="0" Grid.Row="2" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Text="Született" />

        <TextBlock Grid.Column="1" Grid.Row="0" FontSize="15" FontWeight="Light" VerticalAlignment="Center" Text="Szabó Dániel" />
        <TextBlock Grid.Column="1" Grid.Row="1" FontSize="15" FontWeight="Light" VerticalAlignment="Center" Text="419.25T" />
        <TextBlock Grid.Column="1" Grid.Row="2" FontSize="15" FontWeight="Light" VerticalAlignment="Center" Text="2000.06.09." />

    </Grid>
</Window>
