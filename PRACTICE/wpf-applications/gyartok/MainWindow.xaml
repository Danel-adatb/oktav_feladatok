<Window x:Class="gyartok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gyartok"
        mc:Ignorable="d"
        Title="Gyártók" Height="406" Width="800"
        Loaded="Window_Loaded">
    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="GyartokDataGrid"
                  Grid.Column="0"
                  IsReadOnly="True"
                  SelectionUnit="FullRow"
                  SelectionMode="Single"
                  ColumnWidth="*"
                  AutoGenerateColumns="True"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button x:Name="CountBtn"
                    Grid.Row="0"
                    Content="Darabszám"
                    Margin="10,15" 
                    Padding="5"
                    Click="countBtn_Click"/>
            
            <Button x:Name="SubvirseryBtn" 
                    Grid.Row="1"
                    Content="Legtöbb leányvállalat"
                    Margin="10,15" 
                    Padding="5"
                    Click="subvirseryCountBtn_Click"/>
            
            <Button x:Name="ExitBtn"
                    Grid.Row="3"
                    Content="Kilépés"
                    Margin="10,15" 
                    Padding="5"
                    Click="exitBtn_Click"/>
        </Grid>

    </Grid>
</Window>
